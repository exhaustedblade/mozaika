{
  "name": "@mozaika/mcp",
  "version": "0.0.0",
  "private": true,
  "description": "MCP server for AI control of Mozaika models: build, change, run, watch.",
  "type": "module",
  "exports": {
    ".": {
      "@mozaika/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@mozaika/kernel": "workspace:*"
  }
}
