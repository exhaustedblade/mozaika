{
  "name": "@mozaika/viewer",
  "version": "0.0.0",
  "private": true,
  "description": "Web viewer for Mozaika models: scene, charts and controls.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p e2e/tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@babylonjs/core": "9.31.0",
    "@mozaika/blocks": "workspace:*",
    "@mozaika/kernel": "workspace:*",
    "echarts": "6.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "vite": "^8.3.4"
  }
}
