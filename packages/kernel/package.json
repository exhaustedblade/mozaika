{
  "name": "@mozaika/kernel",
  "version": "0.0.0",
  "private": true,
  "description": "Simulation time kernel: event queue, processes, agents and system dynamics on one clock.",
  "type": "module",
  "exports": {
    ".": {
      "@mozaika/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./extension": {
      "@mozaika/source": "./src/extension.ts",
      "types": "./dist/extension.d.ts",
      "default": "./dist/extension.js"
    },
    "./test-support": {
      "@mozaika/source": "./src/test-support/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p bench/tsconfig.json",
    "test": "vitest run",
    "bench": "tsc -p tsconfig.build.json && node bench/events.ts && node --expose-gc bench/agents.ts"
  }
}
